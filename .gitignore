_site/
.jekyll-cache/
.jekyll-metadata

# macOS
.DS_Store

# Bundler
.bundle/
vendor/

# Working source material — NEVER published.
# 20 years of personal Facebook posts live in _content/facebook-processed/.
# The leading underscore also makes Jekyll skip it; this is the second lock.
_content/

# Bulk archives, if one ever ends up nested here by mistake
historic-archive/

# Draft posts: bodies stay local (this repo is PUBLIC).
# The README is committed so the folder is self-documenting.
_drafts/*
!_drafts/README.md

# Worker tooling (added 2026-10-12 with workers/likes). node_modules must never
# land in a PUBLIC repo -- it is thousands of files and occasionally ships
# credentials in a package's own fixtures. .wrangler holds local dev state,
# including the local KV emulation, which is throwaway.
workers/*/node_modules/
workers/*/.wrangler/
workers/*/.dev.vars
